# メール送信などを設定する場合、Panelのファイル管理から.envという名前で保存してください。
# ORIGINとBODY_SIZE_LIMITはPanelの起動設定で指定し、このファイルには重複して書かないでください。
# PORT、DATABASE_URL、REDIS_URL、KENER_BASE_PATHはEggが管理します。
# 秘密鍵は初回起動時に.kener-secretへ自動生成します。通常は手動設定不要です。
# CLOUDFLARED_TOKENはこのファイルに書かず、Panelの起動設定へ入力してください。

# SMTPでメールを送る場合、行頭の#を外して自分の設定を入力してください。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SENDER=status@example.com
# SMTP_SECURE=0

# SMTPの代わりにResendを使う場合:
# RESEND_API_KEY=
# RESEND_SENDER_EMAIL=status@example.com
